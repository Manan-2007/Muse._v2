# Signs session tokens. Generate a fresh one before exposing this publicly:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me-before-deploying"

DATABASE_URL="file:./dev.db"
PORT=4000

# Origins allowed to call this API. Comma-separated, no trailing slashes.
# Must include the deployed frontend, or every request is blocked by CORS.
CLIENT_ORIGIN="http://localhost:5173"

# Set true when the frontend is on a DIFFERENT origin than this API.
# Flips the session cookie to SameSite=None; Secure (requires HTTPS both ends).
CROSS_SITE=false

# Optional. Only YouTube *search* needs it — pasting links works without one.
# YOUTUBE_API_KEY=

# ─── TURN relay (voice / video calls) ────────────────────────────────────────
# Calls between people on DIFFERENT networks need a relay. Without one they
# connect only when a direct path exists — in practice, same wifi.
#
# There is no working credential-free public TURN any more (Open Relay is dead),
# so this needs a free account. Pick ONE:
#
# A) Metered (easiest, 50GB/mo free). Dashboard gives an API key + subdomain.
#    Credentials are minted per-request and expire, which is why it's preferred.
# METERED_API_KEY=
# METERED_DOMAIN=yoursubdomain.metered.live
#
# B) Any static TURN (Twilio, self-hosted coturn, etc.). Comma-separate URLs.
# TURN_URL=turn:your-host:3478,turns:your-host:5349?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ─── Study: the AI half ──────────────────────────────────────────────────────
# Optional. Without these, Study still keeps subjects, documents and the shared
# timer — every button that would call a model is disabled, with the reason on
# it, rather than failing when somebody presses it.
#
# One Azure OpenAI resource, two deployments on it: a chat model and an
# embedding model.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-10-21

# ─── Study: narrating lessons ────────────────────────────────────────────────
# Azure Speech, for the voice on generated lessons. Both of these are optional:
# a Cognitive Services multi-service resource carries Speech on the same key as
# the OpenAI deployments above, and the region is read out of the endpoint
# hostname, so setting AZURE_OPENAI_* is usually enough on its own.
#
# Set these only when Speech lives on a different resource or region.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus2

# ─── Study: running submitted code ───────────────────────────────────────────
# A Judge0-compatible API. Deliberately somebody else's machine: running a
# stranger's code is the one thing here worth refusing to do in-process.
#
# Defaults to Judge0's own public instance, so Run and Submit work without an
# account. That instance is shared and rate limited — point this at your own
# deployment, or at a RapidAPI gateway with a key, if a class is using it in
# earnest.
#
# Set JUDGE_URL to an empty string to turn running off entirely. Problems can
# still be written and read; the buttons disable and say why. That is the
# setting to choose if no code should leave this machine.
# JUDGE_URL=https://judge0-ce.p.rapidapi.com
# JUDGE_API_KEY=
# JUDGE_API_HOST=judge0-ce.p.rapidapi.com

# Embeddings fall back to Gemini when Azure has no embedding deployment.
# A chat deployment and an embedding deployment are separate things on an
# Azure resource — a key that answers gpt-4o does not imply the other exists,
# and the server probes for it rather than assuming. Free key from
# aistudio.google.com; without either, documents upload but are not searchable.
# GEMINI_API_KEY=
