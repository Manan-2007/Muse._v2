# ─── Frontend ────────────────────────────────────────────────────────────────
# Leave EMPTY for local development: Vite proxies /api, /socket.io and /uploads
# to the backend, so everything is same-origin and the session cookie works.
#
# Set it ONLY for a split deployment (e.g. Vercel frontend + tunnelled backend).
# No trailing slash. The app switches to bearer-token auth automatically.
# VITE_API_URL=https://your-tunnel.ngrok-free.app
