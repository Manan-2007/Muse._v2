{
  "name": "muse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "posters": "node scripts/fetch-posters.mjs",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "server:install": "npm --prefix server install",
    "sync": "bash scripts/sync.sh",
    "db:push": "npm --prefix server run db:push",
    "db:studio": "npm --prefix server run db:studio",
    "live": "node scripts/live.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "gl-matrix": "^3.4.4",
    "hls.js": "^1.7.0",
    "html2canvas-pro": "^2.3.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.17.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "shadcn": "^4.18.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
